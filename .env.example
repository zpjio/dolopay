# ==============================================================================
# DoloPay (独行付) 环境变量配置模板
# 复制本文件为 .env 并按需填写（所有审批通道与收款码也可在管理后台界面配置）
# ==============================================================================

# 1. 基础站点与管理员配置
# ------------------------------------------------------------------------------
# 管理员后台访问口令（留空时，首次打开管理后台将引导您在网页端设置口令并加密保存）
DOLOPAY_ADMIN_PASSWORD=
# 站点公网访问地址（用于拼接飞书/钉钉/邮件里的手机审批链接，例如 https://pay.yourdomain.com）
PUBLIC_BASE_URL=
# 收银台站点标题（可选）
DOLOPAY_SITE_TITLE=DoloPay 个人收银台

# 2. 核心默认审批通道（支持单选或同时配置多个，并发推送）
# ------------------------------------------------------------------------------
# [通道 A] 邮件 SMTP 审批（推荐 QQ 邮箱 / 163 邮箱 / Gmail / Resend）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# [通道 B] 飞书群自定义机器人审批
FEISHU_WEBHOOK_URL=
# 飞书机器人安全设置中勾选「签名校验」时填写，未开启可留空
FEISHU_WEBHOOK_SECRET=

# [通道 C] 钉钉群自定义机器人审批
DINGTALK_WEBHOOK_URL=
# 钉钉机器人安全设置中选择「加签」时填写（SEC... 开头），使用关键词模式可留空
DINGTALK_WEBHOOK_SECRET=

# 3. 外部 REST API 密钥（可选，留空首次启动自动随机生成）
# ------------------------------------------------------------------------------
DOLOPAY_API_SECRET=

# 4. 模块化扩展插件配置（默认全部关闭，按需开启或锁定屏蔽）
# ------------------------------------------------------------------------------
# 可选插件 ID：unionpay, bark, telegram, epay, stripe, androidListener, centFloat
# 示例：开启云闪付 + 易支付兼容协议 -> DOLOPAY_ENABLED_PLUGINS=unionpay,epay
DOLOPAY_ENABLED_PLUGINS=
# 示例：生产环境彻底屏蔽不需要的扩展 -> DOLOPAY_DISABLED_PLUGINS=stripe,bark
DOLOPAY_DISABLED_PLUGINS=

# [可选扩展] Bark iOS 强提醒推送地址（例如 https://api.day.app/你的Key/）
BARK_PUSH_URL=

# [可选扩展] Telegram Bot 审批
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [可选扩展] 安卓通知栏监听 Webhook 签名密钥（开启 androidListener 插件时生效）
DOLOPAY_ANDROID_SECRET=